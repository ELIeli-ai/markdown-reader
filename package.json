{
  "name": "markdown-reader",
  "version": "0.1.0",
  "private": true,
  "description": "A focused desktop Markdown reader and editor.",
  "type": "commonjs",
  "main": "./out/main/main.js",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "highlight.js": "11.12.0",
    "marked": "18.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
